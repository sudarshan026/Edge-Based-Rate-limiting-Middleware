# =============================================================================
# AWS Credentials
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# -- AWS Core ------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DEFAULT_REGION=ap-south-1

# -- AWS ElastiCache (Redis) ---------------------------------------------------
# When set, the Shield uses this endpoint instead of the local Redis container.
# Format: redis://<primary-endpoint>:<port>  (no TLS)
#    or   rediss://<primary-endpoint>:<port> (TLS, recommended for production)
# Leave blank to fall back to local Redis (docker-compose Redis service).
ELASTICACHE_URL=

# -- AWS SNS -------------------------------------------------------------------
# ARN of the SNS topic that receives a notification every time a client is
# rate-limited (HTTP 429).  Leave blank to disable SNS alerts.
# Example: arn:aws:sns:ap-south-1:123456789012:rate-limit-alerts
SNS_TOPIC_ARN=

# -- AWS S3 (Audit Logs) -------------------------------------------------------
# S3 bucket name where the Shield flushes JSONL audit logs every
# S3_FLUSH_INTERVAL seconds.  Leave blank to disable S3 audit logging.
# Example: my-rate-limiter-audit-logs
S3_AUDIT_BUCKET=

# How often (seconds) the Shield flushes buffered audit events to S3.
S3_FLUSH_INTERVAL=30

# -- AWS CloudWatch (Logging) --------------------------------------------------
# Log group name for CloudWatch structured logs from all services.
# Leave blank to disable CloudWatch logging (logs go to stdout only).
CLOUDWATCH_LOG_GROUP=/edge-rate-limiter
